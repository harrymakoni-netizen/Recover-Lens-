# Copy to .env and adjust. Loaded by `pnpm dev`, `pnpm db:push` and `pnpm db:seed`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/recoverlens
# API server port (the web app proxies /api here)
API_PORT=8080
# Optional: comma-separated clinician email allowlist
RECOVERLENS_CLINICIAN_EMAILS=
