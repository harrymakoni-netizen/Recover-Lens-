{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "backend/app/**",
        "excludeFiles": "{frontend/**,docs/**,backend/tests/**}"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/sw\\.js",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "dest": "/frontend/sw.js"
    },
    {
      "src": "/models/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      },
      "dest": "/frontend/models/$1"
    },
    {
      "src": "/(assets|mediapipe)/(.*)",
      "dest": "/frontend/$1/$2"
    },
    {
      "src": "/(favicon\\.svg|manifest\\.webmanifest|robots\\.txt)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
